# Primary AI — Groq (fast, free tier, ~30 req/min)
# Used for: Admin Chat, CERT-In reports, ISP NOC notifications, incident analysis
# Get key: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_...

# Secondary Groq key — second independent rate-limit queue for high-volume analysis
# Optional: falls back to VITE_GROQ_API_KEY if absent
VITE_GROQ_API_KEY_2=gsk_...

# Fallback AI — HuggingFace (activates automatically when Groq is rate-limited)
# Get key: https://huggingface.co/settings/tokens → New token (read access is enough)
VITE_HF_API_KEY=hf_...

# Groq models — optional, both fall back to the defaults below if unset.
# Change these to swap models across the whole app without touching code.
# Used by: Admin Chat, incident text analysis (fast) / CERT-In reports,
# ISP NOC notifications, autonomous JSON decisions (accurate)
VITE_GROQ_MODEL_FAST=openai/gpt-oss-20b
VITE_GROQ_MODEL_ACCURATE=openai/gpt-oss-120b

# Supabase — persistent backend (see /supabase-schema.sql for table setup)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
